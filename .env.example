# Copy to .env (or ~/.omh/.env) and fill in whichever key you have.
# OMH loads these without overwriting variables already in the environment.

# Hosted OpenAI-compatible providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Any other OpenAI-compatible endpoint (vLLM, LM Studio, Together, ...)
# OMH_BASE_URL=http://localhost:8000/v1
# OMH_API_KEY=local

# Local Ollama: no key needed, just have it running.
# OLLAMA_API_KEY=

# Optional overrides
# OMH_MODEL=gpt-4o-mini
# OMH_STRATEGY=balanced
# OMH_APPROVAL=ask
# OMH_THEME=hermes
# OMH_MAX_STEPS=12
