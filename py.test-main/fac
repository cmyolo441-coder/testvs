#!/usr/bin/env python3
"""fac — FullAgent thin cloud client.

Your agent runs 100% on your VPS (see cloudserve.py). This tiny client
only sends your prompt and streams the reply. Zero LLM/API work happens
here — stdlib only, runs anywhere (Termux included).

Setup (once):
    fac --set-url https://<your-tunnel>.trycloudflare.com --token <token>

Use:
    fac "refactor auth.py to use JWT"
    echo "summarise this" | fac
"""

from __future__ import annotations

import argparse
import http.client
import json
import os
import sys
import urllib.error
import urllib.request

CFG_DIR = os.path.expanduser("~/.fullagent-cloud")
CFG_FILE = os.path.join(CFG_DIR, "config.json")


def load_cfg() -> dict:
    try:
        with open(CFG_FILE, "r", encoding="utf-8") as f:
            data = json.load(f)
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    # a hand-edited config can hold non-string url/token values; those used
    # to crash cmd_chat with TypeError before any network error handling
    for key in ("url", "token"):
        if key in data:
            val = data[key]
            data[key] = val.strip() if isinstance(val, str) else ""
    return data


def save_cfg(cfg: dict) -> None:
    os.makedirs(CFG_DIR, exist_ok=True)
    fd = os.open(CFG_FILE, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        json.dump(cfg, f)
    os.chmod(CFG_FILE, 0o600)


def cmd_set_url(args) -> int:
    cfg = load_cfg()
    cfg["url"] = args.set_url.rstrip("/")
    if args.token:
        cfg["token"] = args.token
    save_cfg(cfg)
    print(f"server: {cfg['url']}")
    print("token: " + ("saved" if cfg.get("token") else "MISSING — pass --token"))
    return 0


def cmd_health(args) -> int:
    cfg = load_cfg()
    if not cfg.get("url") or not cfg.get("token"):
        print("fac: not configured — run: fac --set-url <url> --token <tok>",
              file=sys.stderr)
        return 2
    try:
        req = urllib.request.Request(
            cfg["url"] + "/health",
            headers={"Authorization": "Bearer " + cfg["token"]})
        with urllib.request.urlopen(req, timeout=20) as resp:
            print(resp.read().decode("utf-8", "replace"))
        return 0
    except urllib.error.HTTPError as e:
        print(f"fac: server error {e.code}", file=sys.stderr)
        return 1
    except Exception as e:  # noqa: BLE001
        print(f"fac: cannot reach server: {e}", file=sys.stderr)
        return 1


def cmd_chat(prompt: str) -> int:
    cfg = load_cfg()
    if not cfg.get("url") or not cfg.get("token"):
        print("fac: not configured — run: fac --set-url <url> --token <tok>",
              file=sys.stderr)
        return 2
    body = json.dumps({"prompt": prompt}).encode("utf-8")
    try:
        req = urllib.request.Request(
            cfg["url"] + "/chat", data=body,
            headers={"Content-Type": "application/json",
                     "Authorization": "Bearer " + cfg["token"]})
        resp = urllib.request.urlopen(req)  # no timeout: turns take minutes
    except urllib.error.HTTPError as e:
        try:
            detail = json.loads(e.read().decode("utf-8", "replace"))
            print(f"fac: server error {e.code}: {detail.get('error', '')}",
                  file=sys.stderr)
        except Exception:
            print(f"fac: server error {e.code}", file=sys.stderr)
        return 1
    except Exception as e:  # noqa: BLE001
        print(f"fac: cannot reach server: {e}", file=sys.stderr)
        return 1

    try:
        with resp:
            # line-by-line: readline() returns each SSE line as it arrives,
            # so tokens stream live instead of waiting for 4096 bytes/EOF.
            for raw in resp:
                line = raw.decode("utf-8", "replace").strip()
                if not line.startswith("data:"):
                    continue
                try:
                    ev = json.loads(line[5:].strip())
                except ValueError:
                    continue
                if not isinstance(ev, dict):
                    continue
                et = ev.get("type")
                tx = ev.get("text")
                tx = "" if tx is None else str(tx)
                if et == "token":
                    sys.stdout.write(tx)
                    sys.stdout.flush()
                elif et == "tool":
                    sys.stderr.write(f"\n[tool: {tx}]\n")
                    sys.stderr.flush()
                elif et == "reasoning":
                    sys.stderr.write(f"\n[thinking: {tx[:120]}]\n")
                    sys.stderr.flush()
                elif et == "error":
                    sys.stderr.write(f"\n[error: {tx}]\n")
                    sys.stderr.flush()
                    return 1
                elif et == "done":
                    try:
                        info = json.loads(tx)
                    except ValueError:
                        info = {}
                    if not isinstance(info, dict):
                        info = {}
                    if info.get("error"):
                        sys.stderr.write(
                            f"\n[done with error: {info.get('error')}]\n")
                        return 1
                    sys.stdout.write("\n")
                    return 0
    except KeyboardInterrupt:
        sys.stderr.write("\n[interrupted — server keeps running]\n")
        return 130
    except (OSError, http.client.HTTPException) as e:
        sys.stderr.write(f"\n[error: connection lost: {e}]\n")
        return 1
    sys.stderr.write("\n[error: stream closed before completion]\n")
    return 1


def main() -> int:
    ap = argparse.ArgumentParser(prog="fac",
                                 description="FullAgent thin cloud client")
    ap.add_argument("--set-url", metavar="URL",
                    help="set server URL (e.g. https://x.trycloudflare.com)")
    ap.add_argument("--token", help="auth token (with --set-url)")
    ap.add_argument("--health", action="store_true",
                    help="check server health")
    ap.add_argument("prompt", nargs="*", help="prompt (or pipe via stdin)")
    args = ap.parse_args()

    if args.set_url:
        return cmd_set_url(args)
    if args.health:
        return cmd_health(args)

    prompt = " ".join(args.prompt).strip()
    if not prompt and not sys.stdin.isatty():
        prompt = sys.stdin.read().strip()
    if not prompt:
        ap.print_help()
        return 2
    return cmd_chat(prompt)


if __name__ == "__main__":
    sys.exit(main())
